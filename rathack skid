local function isAi(player)
	for i = 1, #ainames do
		if player.Name == ainames[i] then
			return true
		end
	end
	return false
end

local function isMod(player)
	if modlist[player.Name] then return true end

	local repinstance = replicatedstorage.Players:FindFirstChild(player.Name)
	if not repinstance then return false end

	local status = repinstance:FindFirstChild("Status")
	if not status then return false end

	local function handle(reason)
        	library:SendNotification(player.Name .. " flagged as mod (" .. reason .. ")", 30)
		modlist[player.Name] = reason
		return true
	end

	if status:FindFirstChild("GameplayVariables") then
		if status.GameplayVariables:GetAttribute("PremiumLevel") >= 4 then
			return handle("premlvl >= 4")
		end
		if status.GameplayVariables:GetAttribute("Godmode") == true then
			return handle("godmode")
		end
	end
	if status:FindFirstChild("UAC") then
		if status.UAC:GetAttribute("A1Detected") == true then
			return handle("#1")
		end
		if status.UAC:GetAttribute("A2Detected") == true then
			return handle("#2")
		end
		if status.UAC:GetAttribute("A3Detected") == true then
			return handle("#3")
		end
	end
	return false
end


