local function setTarget()
	LPH_NO_VIRTUALIZE(function()
		local closestcam, closestdist, player = 9999,9999, nil
		for i,v in pairs(playerdata) do
			local char = v.data.char
			local isbot = v.data.bot

			if not(char) then continue end

			local dist = v.data.distance

			if not(dist) then continue end

			local aimbone = char:FindFirstChild(library.flags.aimbone)

			if not(aimbone) then continue end

			local vect, onscreen = camera:WorldToViewportPoint(aimbone.Position)

			-- ???
			if not(vect) then continue end

			if not(onscreen) then continue end

			-- wtf how
			if not(screencenter) then continue end

			local distFromCenter = (newVector2(vect.X, vect.Y) - screencenter).Magnitude

			-- hate lua
			if not(distFromCenter) then continue end

			local rad = library.flags.aimradius

			if rad == 0 then rad = 2000 end

			local maxdist = library.flags.aimdistance

			if maxdist == 0 then maxdist = 2000 end

			if distFromCenter <= rad and dist <= maxdist then
				if (library.flags.targetai and (isbot or not isbot)) or not(library.flags.targetai and isbot) then
					if library.flags.sortby == "center" then
						if distFromCenter < closestcam then
							closestcam = distFromCenter
							player = v.data
						end
					elseif library.flags.sortby == "distance" then
						if dist < closestdist then
							closestdist = dist
							player = v.data
						end
					elseif library.flags.sortby == "either" then
						if dist < closestdist or distFromCenter < closestcam then
							closestdist = dist
							closestcam = distFromCenter
							player = v.data
						end
					end
				end
			end
		end

		targetdata = player
	end)()
end

