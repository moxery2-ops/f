local function getColorBetweenColors(value, color1, color2)
    -- Normalize the value to be between 0 and 1 (reverse it so 1 = color1 and 0 = color2)
    local normalizedValue = math.clamp(value, 0, 1)
    
    -- Interpolate between color1 and color2 using the normalized value
    local red = color1.R + (color2.R - color1.R) * (1 - normalizedValue)
    local green = color1.G + (color2.G - color1.G) * (1 - normalizedValue)
    local blue = color1.B + (color2.B - color1.B) * (1 - normalizedValue)
    
    -- Return the Color3 for the current color shift
    return Color3.new(red, green, blue)
end

