local function grabAmmo(weapon)
	local ammo, maxammo
    if weapon then
        if weapon:FindFirstChild("Attachments") then
            if weapon.Attachments:FindFirstChild("Magazine") then -- mag/clip
                -- regular guns
                if #weapon.Attachments.Magazine:GetChildren() > 0 then -- checks if gun has a mag or not
                    ammo = weapon.Attachments.Magazine:GetChildren()[1].ItemProperties:GetAttribute("LoadedAmmo")
                    maxammo = weapon.Attachments.Magazine:GetChildren()[1].ItemProperties:GetAttribute("MaxLoadedAmmo")
                end
            else
                -- mosin/sks
		        if weapon:FindFirstChild("ItemProperties") then
                    ammo = weapon.ItemProperties:GetAttribute("LoadedAmmo")
                    maxammo = weapon.ItemProperties:GetAttribute("MaxLoadedAmmo")
		        end
            end
        end
    end
    return ammo, maxammo
end

local function grabKD(playername)
	if replicatedstorage.Players:FindFirstChild(playername) then
		local repinstance = replicatedstorage.Players:FindFirstChild(playername)
		local wipestats = repinstance.Status.Journey.WipeStatistics
		if wipestats then
			local k = wipestats:GetAttribute("Kills")
			local d = wipestats:GetAttribute("Deaths")
			if k == 0 then k = 1 end
			if d == 0 then d = 1 end
			return round(k/d*10)/10
		end
	end
	return 0
end

