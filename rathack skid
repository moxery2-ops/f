local function isPartVisible(part, origin)

	-- question mark???
	if not part or not part.Position then return false end

	local result = rayBetween2(part.CFrame.Position, origin)

	if result then
		local hit = result.Instance

		return not hit or hit:IsDescendantOf(part.Parent)
	end

	return false
end

local function getVisibleOrigin(destination, origin)
	local amount = library.flags.manipulationamount
	if isPartVisible(destination, origin) then
		return false
	end
	for i = 1, amount do
		local grabbed = false
		local possible = {
            newVector3(origin.X + i, origin.Y, origin.Z),
			newVector3(origin.X, origin.Y, origin.Z + i),
			newVector3(origin.X, origin.Y + i, origin.Z),

            newVector3(origin.X - i, origin.Y, origin.Z),
            newVector3(origin.X, origin.Y, origin.Z - i),
			newVector3(origin.X, origin.Y - i, origin.Z)
        }

		for _, newOr in pairs(possible) do
			if isPartVisible(destination, newOr) then
				grabbed = true
				return newOr
			end
		end

		if grabbed then break end
	end

	-- if nothing passed
	return false
end

local function isResolvable(destination, origin, amount)
	if isPartVisible(destination, origin) then
		return false
	end
	local newOr = newVector3(origin.X, origin.Y - amount, origin.Z)
	if isPartVisible(destination, newOr) then
		return newOr
	end

	-- if nothing passed
	return false
end

