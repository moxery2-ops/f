    local args = {...}
	local method = getnamecallmethod()
    if not checkcaller() then
		if method == "GetAttribute" then
			--if library.flags.norecoil and args[1] == "RecoilStrength" then
				--return 0.1
			--end
			if library.flags.nospread and args[1] == "AccuracyDeviation" then
				return 0
			end
			if library.flags.nodrop and args[1] == "ProjectileDrop" then
				return 0
			end
		end
		if method == "InvokeServer" then
			if library.flags.instantreload and self.Name == "Reload" then
				args[2] = 0
			end
			if library.flags.instanthit and library.flags.instantmethod == "invoke" and self.name == "FireProjectile" then
				if targetdata and bulletdata and bulletdata.part then
					local part = bulletdata.part
					if part then
						local dist = part.Position - args[1]
						task.spawn(function()
							replicatedstorage.Remotes.ProjectileInflict:FireServer(
								part,
								CFrame.new(0,0.2,-0.2),
								args[2],
								args[3] + dist.Magnitude * 0.0065
							)
						end)
					end
				end
			end
		end
		if method == "FireServer" then
			if self.Name == "Drowning" and library.flags.antidrown then
				return task.wait(9e9)
			end
		    if self.Name == "ProjectileInflict" then
				-- antiban
				if args[1] and args[1].Name == "HumanoidRootPart" then
            		return coroutine.yield()
        		end
				if library.flags.instanthit and library.flags.instantmethod == "raycast" then
                	args[4] = 0/0
				end
		    end
		end
		if method == "Raycast" then
			if getinfo(3).short_src == "ReplicatedStorage.Modules.FPS.Bullet" then
				--local args = {...}
				if library.flags.instanthit and library.flags.instantmethod == "raycast" then
					if targetdata and bulletdata and bulletdata.endpos then
						local dir = bulletdata.endpos - args[1]
						-- we have nothing to calculate the actual velocity unless im tweaking idk lmao
						local velo = dir.Unit * 10
						local dist = dir.Magnitude
						args[2] = velo * dist
					else
						args[2] = args[2] * 5
					end
				end
				if library.flags.ignorewater then
					args[3].IgnoreWater = true
				end
				--return namecall(self, unpack(args))
			end
		end
	end

	return namecall(self, unpack(args))
