local oldBullet = gamevars.Bullet.CreateBullet
gamevars.Bullet.CreateBullet = function(self,...)
	local arguments = {...}
	bulletdata = {}

	local chance = library.flags.playeraimchance

	if targetdata and targetdata.bot then
		chance = library.flags.aiaimchance
	end

	if chance == 0 then chance = 100 end

	-- no point in doin all the math if it aint even gonna aim lol
	if arguments[4] and targetdata and library.flags.silentaim and random() <= chance/100 then
		local oldHealth = 100
		if targetdata.health ~= nil then
			oldHealth = targetdata.health
		end
		local localAmmo = replicatedstorage.AmmoTypes:FindFirstChild(tostring(arguments[6]))
		local targetpart = targetdata.targetpart
		local aimp = arguments[4].CFrame.Position

		if library.flags.underground and library.flags.undergroundbind and dysenc[3] then
			aimp = dysenc[3]:FindFirstChild("Head").Position
		end

		if library.flags.randombone then
			local randomized = characterparts[random(#characterparts)]
			targetpart = targetdata.char:FindFirstChild(randomized)
		end

		if library.flags.onshotscan then
			local highest = getHighestPart(targetdata,aimp)
			if highest then -- returns nil sometimes if nothing is visible, just how it be sometimes
				local pickedpart = targetdata.char:FindFirstChild(highest)
				if pickedpart then
					targetpart = pickedpart
				end
			end
		end

	if library.flags.manipulation and library.flags.manipulationbind then
			task.spawn(function()
				local bestOrigin = getVisibleOrigin(targetdata.targetpart,aimp)
				if bestOrigin then
					local savedPos = localroot.CFrame
					local distFromNew = bestOrigin - savedPos.Position
					localroot.CFrame = savedPos + distFromNew
					aimp = aimp + distFromNew
					targetpos = targetdata.targetpart.CFrame.Position
					task.wait(library.flags.manipulationreturndelay)
					localroot.CFrame = savedPos
				end
			end)
		end

		if library.flags.resolver and library.flags.resolverbind then
			task.spawn(function()
				local savedPos = localroot.CFrame
				localroot.CFrame = savedPos - newVector3(0,library.flags.resolveramount,0)
				aimp = aimp - newVector3(0,library.flags.resolveramount,0)
				task.wait(library.flags.resolverreturndelay)
				localroot.CFrame = savedPos
			end)
		end

		if library.flags.vischeck and isPartVisible(targetpart, camera.CFrame.Position) or not library.flags.vischeck then 
			local targetpos = targetpart.Position

			if library.flags.prediction then
				local movePred = movementPrediction(aimp, targetpos, targetpart.Velocity, localAmmo:GetAttribute("MuzzleVelocity"))
				local bulletDrop = dropPrediction(aimp, movePred, localAmmo:GetAttribute("MuzzleVelocity"), localAmmo:GetAttribute("ProjectileDrop"))
				targetpos = newVector3(movePred.X, movePred.Y + bulletDrop, movePred.Z)
			end

			arguments[4] = {
				CFrame = CFrame.new(aimp, targetpos),
				Position = aimp
			}

			bulletdata = {
				part = targetpart,
				startpos = aimp,
				endpos = targetpos
			}

			if library.flags.bullettracer then
				local b = createBeam(aimp, targetpos, library.flags.bullettracercolor, library.flags.tracerrate, library.flags.tracerwidth)
				if library.flags.onhittracer then
					task.spawn(function()
						task.wait(0.1)
						if targetdata.health ~= nil then
							local newHealth = targetdata.health
							if newHealth < oldHealth then
								b.Color = ColorSequence.new(library.flaggs.onhittracercolor)
							end
						end
					end)
				end
			end
		end
	end

	if library.flags.shotamount > 1 then
		for i = 1, library.flags.shotamount-1 do
			oldBullet(self,unpack(arguments))
		end
	end

	return oldBullet(self,unpack(arguments))
end


